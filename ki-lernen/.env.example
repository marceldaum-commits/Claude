# Kopiere diese Datei nach .env (nur auf dem Server!) und trage die Werte ein.
# .env wird nie ins Repo eingecheckt.

# Claude-API-Schlüssel von https://platform.claude.com
ANTHROPIC_API_KEY=

# Modell. Standard: claude-opus-5-5 (4 $ / 20 $ pro Mio. Tokens).
# Deutlich günstiger für viele Tester: claude-haiku-5-5 (0,10 $ / 0,50 $).
KI_MODEL=claude-opus-5-5

# Einladungscodes: CODE:Name, durch Komma getrennt. Ohne gültigen Code keine KI-Anfragen.
# Nur lange Zufallscodes verwenden! Erzeugen mit:  openssl rand -hex 8
# (Nach 10 falschen Versuchen wird eine IP für 15 Minuten gesperrt.)
INVITE_CODES=HIER-ZUFALLSCODE-1:Marcel,HIER-ZUFALLSCODE-2:Tester 1

# Monatsbudget pro Code in US-Dollar (KI-Kosten). Danach sperrt die App bis Monatsende.
BUDGET_USD_PER_CODE=2

# Port und Adresse: nur lokal, Plesk leitet ki.<domain> hierher weiter.
# (Port 8090 gehört der Kali-Arena – nicht verwenden.)
PORT=8100
HOST=127.0.0.1
