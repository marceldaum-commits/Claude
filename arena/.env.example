# Kopieren nach .env und anpassen
ARENA_DOMAIN=labs.example.de          # Subdomain, deren DNS-A-Eintrag auf den Server zeigt
ARENA_CODE=bitte-langes-zufaelliges-wort   # Einladungscode für Beta-Tester
MAX_SESSIONS=20                        # gleichzeitige Labs insgesamt (16 GB RAM: ~40 möglich)
MAX_PER_IP=2
SESSION_MINUTES=120
IDLE_MINUTES=20
MEMORY_MB=256
CPUS=0.5
KELLER_IMAGE=kly-keller
